# Sao chep file nay thanh .env (hoac dien vao phan Environment Variables cua noi ban thue may chu)

# Bat buoc: API key cua OpenAI (tao tai https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-...

# Bat buoc: chuoi bi mat bat ky, cang dai cang tot (dung de ky phien dang nhap)
JWT_SECRET=doi-thanh-chuoi-ngau-nhien-dai

# Email cua BAN (tai khoan quan tri - dang ky bang email nay de thay bang quan tri)
ADMIN_EMAIL=baovip9xyenlap12345@gmail.com

# Thong tin chuyen khoan hien cho khach khi nang goi
BANK_INFO=Ngan hang: Vietcombank | So TK: 0123456789 | Chu TK: NGUYEN VAN A | Noi dung: TEN GOI + email cua ban

# Thong tin lien he ho tro (hien tren trang, vd Zalo) - de trong neu chua co
CONTACT_INFO=Zalo: 09xx.xxx.xxx

# Moi video toi da bao nhieu phut (mac dinh 5)
MAX_VIDEO_MINUTES=5

# Cong chay (da so noi thue tu dat, khong can sua)
PORT=3000

# ===== KET NOI WORDPRESS (de sua tai khoan + cau hinh site tai /wordpress.html) =====
# Dia chi site WordPress, co https://, KHONG co dau / o cuoi
WP_URL=https://buihuubao.vn

# Ten dang nhap WordPress
WP_USERNAME=admin_app2

# Mat khau UNG DUNG (Application Password), KHONG phai mat khau dang nhap.
# Tao tai: WordPress > Nguoi dung (Users) > Ho so (Profile) > Application Passwords
# Chuoi 24 ky tu; co the giu nguyen khoang trang, ma nguon tu bo di.
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# Cho WordPress tra loi toi da bao nhieu mili giay (mac dinh 20000)
WP_TIMEOUT_MS=20000
