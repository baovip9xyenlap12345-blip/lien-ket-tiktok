generator client {
  provider      = "prisma-client-js"
  // native = may dev (glibc); linux-musl-openssl-3.0.x = container Alpine production
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id        Int      @id @default(autoincrement())
  name      String
  taxCode   String?
  address   String?
  phone     String?
  web       String?
  logoUrl   String?
  branches  Branch[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Branch {
  id         Int         @id @default(autoincrement())
  companyId  Int
  company    Company     @relation(fields: [companyId], references: [id])
  code       String      @unique
  name       String
  address    String?
  warehouses Warehouse[]
  users      User[]
  deletedAt  DateTime?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
}

model Warehouse {
  id        Int       @id @default(autoincrement())
  branchId  Int
  branch    Branch    @relation(fields: [branchId], references: [id])
  code      String    @unique
  name      String
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Role {
  id       Int              @id @default(autoincrement())
  code     String           @unique
  name     String
  isSystem Boolean          @default(false)
  perms    RolePermission[]
  users    User[]
}

model Permission {
  id    Int              @id @default(autoincrement())
  code  String           @unique
  name  String
  roles RolePermission[]
}

model RolePermission {
  roleId       Int
  permissionId Int
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  @@id([roleId, permissionId])
}

enum DataScope {
  OWN
  TEAM
  BRANCH
  ALL
}

model User {
  id           Int       @id @default(autoincrement())
  username     String    @unique
  passwordHash String
  name         String
  email        String?
  phone        String?
  roleId       Int
  role         Role      @relation(fields: [roleId], references: [id])
  branchId     Int?
  branch       Branch?   @relation(fields: [branchId], references: [id])
  scope        DataScope @default(OWN)
  active       Boolean   @default(true)
  deletedAt    DateTime?
  sessions     Session[]
  partnersSale    Partner[]      @relation("PartnerSale")
  partnersCreated Partner[]      @relation("PartnerCreator")
  careAssigned    CareActivity[] @relation("CareAssignee")
  careCreated     CareActivity[] @relation("CareCreator")
  filesUploaded   Attachment[]   @relation("FileUploader")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  @@index([roleId])
}

model Session {
  token     String   @id
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  ip        String?
  ua        String?
  createdAt DateTime @default(now())
  @@index([userId])
  @@index([expiresAt])
}

model Setting {
  key   String @id
  value Json
}

model DocumentSequence {
  id         Int    @id @default(autoincrement())
  prefix     String
  branchCode String
  period     String
  nextNo     Int    @default(1)
  @@unique([prefix, branchCode, period])
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  actorId   Int?
  actorName String
  action    String
  entity    String
  entityId  String?
  before    Json?
  after     Json?
  ip        String?
  ua        String?
  at        DateTime @default(now())
  @@index([entity, entityId])
  @@index([at])
}

// ===== GD2: SAN PHAM & HANG HOA =====

enum ProductType {
  FINISHED
  MATERIAL
  SEMI
  SERVICE
  COMBO
  CUSTOM
  AI_BEAR
}

enum ProductStatus {
  ACTIVE
  INACTIVE
}

model Category {
  id       Int       @id @default(autoincrement())
  name     String
  parentId Int?
  parent   Category?  @relation("CatTree", fields: [parentId], references: [id])
  children Category[] @relation("CatTree")
  products Product[]
  deletedAt DateTime?
}

model Unit {
  id       Int    @id @default(autoincrement())
  code     String @unique
  name     String
  products Product[]
  fromConv UnitConversion[] @relation("FromUnit")
  toConv   UnitConversion[] @relation("ToUnit")
}

model UnitConversion {
  id         Int   @id @default(autoincrement())
  fromUnitId Int
  toUnitId   Int
  factor     Decimal @db.Decimal(18, 6)
  fromUnit   Unit  @relation("FromUnit", fields: [fromUnitId], references: [id])
  toUnit     Unit  @relation("ToUnit", fields: [toUnitId], references: [id])
  locked     Boolean @default(false)
  @@unique([fromUnitId, toUnitId])
}

model Product {
  id         Int           @id @default(autoincrement())
  code       String        @unique
  name       String
  type       ProductType
  status     ProductStatus @default(ACTIVE)
  categoryId Int?
  category   Category?     @relation(fields: [categoryId], references: [id])
  unitId     Int
  unit       Unit          @relation(fields: [unitId], references: [id])
  brand      String?
  tags       String[]      @default([])
  desc       String?
  imageUrls  String[]      @default([])
  videoUrl   String?
  variantGroups Json?
  qtyTiers   Json?
  taxPercent Int?
  costRef    Int           @default(0)
  deductMode String?
  note       String?
  variants   ProductVariant[]
  bundleItems BundleItem[] @relation("ComboOwner")
  boms       Bom[]
  version    Int           @default(1)
  deletedAt  DateTime?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  @@index([type, status])
  @@index([name])
}

model ProductVariant {
  id        Int      @id @default(autoincrement())
  productId Int
  product   Product  @relation(fields: [productId], references: [id])
  sku       String   @unique
  barcode   String?  @unique
  size      String?
  color     String?
  material  String?
  costPrice Int      @default(0)
  weightGr  Int?
  minStock  Int      @default(0)
  maxStock  Int?
  imageUrls String[] @default([])
  status    ProductStatus @default(ACTIVE)
  priceRules PriceRule[]
  bundleComponents BundleItem[] @relation("ComponentVariant")
  bomItems  BomItem[]
  aiDevices AiDevice[]
  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([productId])
}

enum PriceListKind {
  RETAIL
  WHOLESALE
  AGENT
  COMPANY
  CUSTOM
}

model PriceList {
  id        Int           @id @default(autoincrement())
  kind      PriceListKind
  name      String
  priority  Int           @default(0)
  validFrom DateTime?
  validTo   DateTime?
  active    Boolean       @default(true)
  rules     PriceRule[]
  deletedAt DateTime?
}

model PriceRule {
  id          Int            @id @default(autoincrement())
  priceListId Int
  priceList   PriceList      @relation(fields: [priceListId], references: [id])
  variantId   Int
  variant     ProductVariant @relation(fields: [variantId], references: [id])
  minQty      Int            @default(1)
  price       Int
  @@unique([priceListId, variantId, minQty])
  @@index([variantId])
}

model BundleItem {
  id                 Int            @id @default(autoincrement())
  comboProductId     Int
  comboProduct       Product        @relation("ComboOwner", fields: [comboProductId], references: [id])
  componentVariantId Int
  componentVariant   ProductVariant @relation("ComponentVariant", fields: [componentVariantId], references: [id])
  qty                Int
  @@unique([comboProductId, componentVariantId])
}

model Bom {
  id        Int          @id @default(autoincrement())
  productId Int
  product   Product      @relation(fields: [productId], references: [id])
  name      String
  versions  BomVersion[]
  deletedAt DateTime?
}

enum BomStatus {
  DRAFT
  ACTIVE
  RETIRED
}

model BomVersion {
  id        Int       @id @default(autoincrement())
  bomId     Int
  bom       Bom       @relation(fields: [bomId], references: [id])
  no        Int
  status    BomStatus @default(DRAFT)
  validFrom DateTime?
  wastePct  Decimal   @db.Decimal(5, 2) @default(0)
  items     BomItem[]
  createdAt DateTime  @default(now())
  @@unique([bomId, no])
}

model BomItem {
  id                Int            @id @default(autoincrement())
  bomVersionId      Int
  bomVersion        BomVersion     @relation(fields: [bomVersionId], references: [id])
  materialVariantId Int
  materialVariant   ProductVariant @relation(fields: [materialVariantId], references: [id])
  qtyPerUnit        Decimal        @db.Decimal(18, 4)
  note              String?
}

model AiDevice {
  id             Int            @id @default(autoincrement())
  variantId      Int
  variant        ProductVariant @relation(fields: [variantId], references: [id])
  serial         String         @unique
  activatedAt    DateTime?
  warrantyMonths Int            @default(12)
  note           String?
  createdAt      DateTime       @default(now())
}

// ===== GD3: DOI TAC & CRM =====

enum PartnerType {
  PERSON
  COMPANY
}

model PartnerGroup {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  partners Partner[]
}

model Partner {
  id           Int         @id @default(autoincrement())
  code         String      @unique
  name         String
  type         PartnerType @default(PERSON)
  isCustomer   Boolean     @default(true)
  isSupplier   Boolean     @default(false)
  isAgent      Boolean     @default(false)
  phone        String?
  normPhone    String?
  email        String?
  normEmail    String?
  taxCode      String?
  groupId      Int?
  group        PartnerGroup? @relation(fields: [groupId], references: [id])
  source       String?
  channel      String?
  priceListId  Int?
  assignedToId Int?
  assignedTo   User?       @relation("PartnerSale", fields: [assignedToId], references: [id])
  createdById  Int?
  createdBy    User?       @relation("PartnerCreator", fields: [createdById], references: [id])
  branchId     Int?
  creditLimit  Int         @default(0)
  creditDays   Int         @default(0)
  isVip        Boolean     @default(false)
  note         String?
  mergedIntoId Int?
  contacts     PartnerContact[]
  addresses    PartnerAddress[]
  activities   CareActivity[]
  attachments  Attachment[]
  deletedAt    DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  @@index([normPhone])
  @@index([normEmail])
  @@index([taxCode])
  @@index([assignedToId])
  @@index([name])
}

model PartnerContact {
  id        Int     @id @default(autoincrement())
  partnerId Int
  partner   Partner @relation(fields: [partnerId], references: [id])
  name      String
  phone     String?
  email     String?
  position  String?
  note      String?
  deletedAt DateTime?
}

model PartnerAddress {
  id         Int     @id @default(autoincrement())
  partnerId  Int
  partner    Partner @relation(fields: [partnerId], references: [id])
  label      String?
  address    String
  isBilling  Boolean @default(false)
  isShipping Boolean @default(false)
  deletedAt  DateTime?
}

enum CareKind {
  NOTE
  CALL
  TASK
  MEETING
}

model CareActivity {
  id          Int      @id @default(autoincrement())
  partnerId   Int
  partner     Partner  @relation(fields: [partnerId], references: [id])
  kind        CareKind @default(NOTE)
  content     String
  dueAt       DateTime?
  remindAt    DateTime?
  doneAt      DateTime?
  assigneeId  Int?
  assignee    User?    @relation("CareAssignee", fields: [assigneeId], references: [id])
  createdById Int
  createdBy   User     @relation("CareCreator", fields: [createdById], references: [id])
  deletedAt   DateTime?
  createdAt   DateTime @default(now())
  @@index([partnerId])
  @@index([assigneeId, doneAt])
}

model Attachment {
  id           Int      @id @default(autoincrement())
  partnerId    Int?
  partner      Partner? @relation(fields: [partnerId], references: [id])
  entity       String
  entityId     String
  fileName     String
  mime         String
  size         Int
  storageKey   String   @unique
  uploadedById Int
  uploadedBy   User     @relation("FileUploader", fields: [uploadedById], references: [id])
  deletedAt    DateTime?
  createdAt    DateTime @default(now())
  @@index([entity, entityId])
}

// ===== GD4: BAO GIA, DON HANG, POS =====

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  CANCELLED
}

enum ApprovalStatus {
  NONE
  PENDING
  APPROVED
  REJECTED
}

enum OrderStatus {
  NEW
  CONFIRMED
  DONE
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
  REFUNDED
}

enum ProductionStatus {
  NONE
  QUEUED
  IN_PROGRESS
  FINISHED
}

enum ShippingStatus {
  NONE
  PREPARING
  SHIPPING
  DELIVERED
  RETURNED
}

enum PayMethod {
  CASH
  TRANSFER
}

model Quote {
  id             Int            @id @default(autoincrement())
  code           String         @unique
  version        Int            @default(1)
  partnerId      Int?
  partnerName    String
  priceListId    Int?
  status         QuoteStatus    @default(DRAFT)
  approvalStatus ApprovalStatus @default(NONE)
  approvalReason String?
  approvedById   Int?
  approvedAt     DateTime?
  vatEnabled     Boolean        @default(true)
  vatPercent     Int            @default(8)
  subtotal       Int            @default(0)
  discountPct    Decimal        @db.Decimal(5, 2) @default(0)
  discountAmt    Int            @default(0)
  otherFee       Int            @default(0)
  shippingFee    Int            @default(0)
  taxAmt         Int            @default(0)
  total          Int            @default(0)
  validUntil     DateTime?
  note           String?
  lines          QuoteLine[]
  revisions      QuoteRevision[]
  order          SalesOrder?
  assignedToId   Int?
  createdById    Int
  branchId       Int?
  deletedAt      DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  @@index([partnerId])
  @@index([status])
}

model QuoteLine {
  id          Int     @id @default(autoincrement())
  quoteId     Int
  quote       Quote   @relation(fields: [quoteId], references: [id])
  variantId   Int?
  sku         String
  name        String
  unit        String
  qty         Int
  unitPrice   Int
  discountPct Decimal @db.Decimal(5, 2) @default(0)
  taxPercent  Int     @default(0)
  lineTotal   Int
  note        String?
}

model QuoteRevision {
  id        Int      @id @default(autoincrement())
  quoteId   Int
  quote     Quote    @relation(fields: [quoteId], references: [id])
  version   Int
  data      Json
  createdAt DateTime @default(now())
  @@unique([quoteId, version])
}

model SalesOrder {
  id               Int              @id @default(autoincrement())
  code             String           @unique
  quoteId          Int?             @unique
  quote            Quote?           @relation(fields: [quoteId], references: [id])
  partnerId        Int?
  partnerName      String
  orderStatus      OrderStatus      @default(NEW)
  paymentStatus    PaymentStatus    @default(UNPAID)
  productionStatus ProductionStatus @default(NONE)
  shippingStatus   ShippingStatus   @default(NONE)
  approvalStatus   ApprovalStatus   @default(NONE)
  approvalReason   String?
  approvedById     Int?
  approvedAt       DateTime?
  vatEnabled       Boolean          @default(true)
  vatPercent       Int              @default(8)
  subtotal         Int              @default(0)
  discountPct      Decimal          @db.Decimal(5, 2) @default(0)
  discountAmt      Int              @default(0)
  otherFee         Int              @default(0)
  shippingFee      Int              @default(0)
  taxAmt           Int              @default(0)
  total            Int              @default(0)
  paidAmt          Int              @default(0)
  isPos            Boolean          @default(false)
  note             String?
  lines            OrderLine[]
  payments         Payment[]
  assignedToId     Int?
  createdById      Int
  branchId         Int?
  deletedAt        DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  @@index([partnerId])
  @@index([orderStatus, paymentStatus])
  @@index([createdAt])
}

model OrderLine {
  id          Int        @id @default(autoincrement())
  orderId     Int
  order       SalesOrder @relation(fields: [orderId], references: [id])
  variantId   Int?
  sku         String
  name        String
  unit        String
  qty         Int
  unitPrice   Int
  discountPct Decimal    @db.Decimal(5, 2) @default(0)
  taxPercent  Int        @default(0)
  lineTotal   Int
  note        String?
}

model Payment {
  id          Int        @id @default(autoincrement())
  code        String     @unique
  orderId     Int
  order       SalesOrder @relation(fields: [orderId], references: [id])
  partnerId   Int?
  amount      Int
  method      PayMethod  @default(CASH)
  note        String?
  cashTxId    Int?
  createdById Int
  createdAt   DateTime   @default(now())
  @@index([orderId])
  @@index([createdAt])
}

model StatusHistory {
  id        Int      @id @default(autoincrement())
  entity    String
  entityId  Int
  axis      String
  fromVal   String
  toVal     String
  note      String?
  byId      Int
  byName    String
  createdAt DateTime @default(now())
  @@index([entity, entityId])
}

// ===== GD5: THU TIEN, CONG NO, SO QUY =====

enum CashAccountKind {
  CASH
  BANK
  COD
}

enum CashTxKind {
  RECEIPT
  PAYMENT
  TRANSFER_IN
  TRANSFER_OUT
  REFUND
}

enum CashTxStatus {
  PENDING
  APPROVED
  REJECTED
}

model CashAccount {
  id             Int             @id @default(autoincrement())
  code           String          @unique
  name           String
  kind           CashAccountKind
  openingBalance Int             @default(0)
  active         Boolean         @default(true)
  txs            CashTransaction[]
  createdAt      DateTime        @default(now())
}

model CashTransaction {
  id             Int          @id @default(autoincrement())
  code           String       @unique
  kind           CashTxKind
  status         CashTxStatus @default(APPROVED)
  accountId      Int
  account        CashAccount  @relation(fields: [accountId], references: [id])
  amount         Int
  partnerId      Int?
  partnerName    String?
  orderId        Int?
  reason         String?
  note           String?
  happenedAt     DateTime     @default(now())
  period         String
  transferGroup  String?
  refundOfId     Int?
  refundOf       CashTransaction?  @relation("RefundLink", fields: [refundOfId], references: [id])
  refunds        CashTransaction[] @relation("RefundLink")
  idempotencyKey String?      @unique
  approvedById   Int?
  approvedAt     DateTime?
  createdById    Int
  createdByName  String
  createdAt      DateTime     @default(now())
  @@index([accountId, period])
  @@index([orderId])
  @@index([partnerId])
  @@index([happenedAt])
}

model PeriodLock {
  period       String    @id
  locked       Boolean   @default(true)
  lockedById   Int
  lockedByName String
  lockedAt     DateTime  @default(now())
  note         String?
}

// ===== GD6: KHO & GIAO HANG =====

enum MovementKind {
  RECEIPT
  ISSUE
  SALE
  TRANSFER_IN
  TRANSFER_OUT
  ADJUST
  RETURN
  SCRAP
}

// Chung tu kho BAT BIEN — khong co API sua/xoa. qty: + nhap, - xuat.
model StockMovement {
  id          Int          @id @default(autoincrement())
  warehouseId Int
  variantId   Int
  kind        MovementKind
  qty         Int
  refType     String?
  refId       String?
  note        String?
  byId        Int
  byName      String
  createdAt   DateTime     @default(now())
  @@index([warehouseId, variantId])
  @@index([refType, refId])
  @@index([createdAt])
}

// Projection tu StockMovement — cap nhat cung transaction, khoa dong chong am kho.
model InventoryBalance {
  id          Int @id @default(autoincrement())
  warehouseId Int
  variantId   Int
  onHand      Int @default(0)
  reserved    Int @default(0)
  @@unique([warehouseId, variantId])
}

model StockReservation {
  id          Int      @id @default(autoincrement())
  orderId     Int?
  prodId      Int?
  warehouseId Int
  variantId   Int
  qty         Int
  released    Boolean  @default(false)
  createdAt   DateTime @default(now())
  @@index([orderId])
  @@index([warehouseId, variantId, released])
}

enum ShipmentStatus {
  PREPARING
  SHIPPING
  DELIVERED
  RETURNED
  CANCELLED
}

enum CodStatus {
  NONE
  PENDING
  RECONCILED
}

model Shipment {
  id          Int            @id @default(autoincrement())
  code        String         @unique
  orderId     Int
  warehouseId Int
  status      ShipmentStatus @default(PREPARING)
  carrier     String?
  trackingNo  String?
  shipFee     Int            @default(0)
  codAmount   Int            @default(0)
  codStatus   CodStatus      @default(NONE)
  codTxId     Int?
  restock     Boolean?
  note        String?
  lines       ShipmentLine[]
  createdById Int
  createdByName String
  deliveredAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  @@index([orderId])
  @@index([status, codStatus])
}

model ShipmentLine {
  id         Int      @id @default(autoincrement())
  shipmentId Int
  shipment   Shipment @relation(fields: [shipmentId], references: [id])
  variantId  Int
  sku        String
  name       String
  qty        Int
}

enum StocktakeStatus {
  DRAFT
  DONE
}

model Stocktake {
  id          Int             @id @default(autoincrement())
  code        String          @unique
  warehouseId Int
  status      StocktakeStatus @default(DRAFT)
  note        String?
  lines       StocktakeLine[]
  createdById Int
  createdByName String
  doneAt      DateTime?
  createdAt   DateTime        @default(now())
}

model StocktakeLine {
  id          Int       @id @default(autoincrement())
  stocktakeId Int
  stocktake   Stocktake @relation(fields: [stocktakeId], references: [id])
  variantId   Int
  sku         String
  systemQty   Int
  countedQty  Int
}

// ===== GD7: THIET KE, DUYET MAU, SAN XUAT =====

enum DesignStatus {
  OPEN
  APPROVED
  CANCELLED
}

enum DesignVersionStatus {
  PENDING
  APPROVED
  REJECTED
}

model DesignRequest {
  id          Int             @id @default(autoincrement())
  code        String          @unique
  title       String
  desc        String?
  partnerId   Int?
  partnerName String?
  orderId     Int?
  status      DesignStatus    @default(OPEN)
  versions    DesignVersion[]
  createdById Int
  createdByName String
  deletedAt   DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model DesignVersion {
  id             Int                 @id @default(autoincrement())
  designId       Int
  design         DesignRequest       @relation(fields: [designId], references: [id])
  no             Int
  imageUrl       String?
  note           String?
  status         DesignVersionStatus @default(PENDING)
  decidedById    Int?
  decidedByName  String?
  decidedAt      DateTime?
  decideNote     String?
  comments       DesignComment[]
  productionOrders ProductionOrder[]
  createdById    Int
  createdByName  String
  createdAt      DateTime            @default(now())
  @@unique([designId, no])
}

model DesignComment {
  id        Int           @id @default(autoincrement())
  versionId Int
  version   DesignVersion @relation(fields: [versionId], references: [id])
  content   String
  byId      Int
  byName    String
  createdAt DateTime      @default(now())
}

enum ProductionStatus2 {
  DRAFT
  RELEASED
  IN_PROGRESS
  DONE
  CANCELLED
}

enum ProductionStage {
  PREP
  CUT
  SEW
  STUFF
  FINISH
  QC
  PACK
}

model ProductionOrder {
  id              Int               @id @default(autoincrement())
  code            String            @unique
  orderId         Int?
  variantId       Int
  bomVersionId    Int?
  designVersionId Int?
  designVersion   DesignVersion?    @relation(fields: [designVersionId], references: [id])
  overrideNote    String?
  warehouseId     Int
  qtyPlanned      Int
  qtyGood         Int               @default(0)
  qtyDefect       Int               @default(0)
  qtyScrap        Int               @default(0)
  status          ProductionStatus2 @default(DRAFT)
  dueDate         DateTime?
  materialsIssued Boolean           @default(false)
  finishedReceipted Boolean         @default(false)
  costEstimate    Int               @default(0)
  costActual      Int               @default(0)
  note            String?
  steps           ProductionStep[]
  createdById     Int
  createdByName   String
  deletedAt       DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  @@index([status, dueDate])
}

model ProductionStep {
  id        Int             @id @default(autoincrement())
  prodId    Int
  prod      ProductionOrder @relation(fields: [prodId], references: [id])
  stage     ProductionStage
  qtyGood   Int             @default(0)
  qtyDefect Int             @default(0)
  qtyRework Int             @default(0)
  photoUrl  String?
  note      String?
  checklist Json?
  byId      Int
  byName    String
  createdAt DateTime        @default(now())
  @@index([prodId, stage])
}

model QcChecklist {
  id          Int         @id @default(autoincrement())
  productType ProductType @unique
  items       String[]
}

// ===== GD8: NHAN VIEN, KPI, HOA HONG, LUONG =====
// LUU Y: day la quan tri noi bo cua xuong — KHONG phai he thong ke khai luong/thue phap ly.

model EmployeeProfile {
  userId      Int      @id
  position    String?
  joinDate    DateTime?
  baseSalary  Int      @default(0)
  allowance   Int      @default(0)
  bankAccount String?
  note        String?
  updatedAt   DateTime @updatedAt
}

model TimesheetEntry {
  id        Int      @id @default(autoincrement())
  userId    Int
  date      DateTime @db.Date
  day       Decimal  @db.Decimal(3, 2)
  note      String?
  byId      Int
  byName    String
  updatedAt DateTime @updatedAt
  @@unique([userId, date])
}

enum HrTaskStatus {
  OPEN
  DOING
  DONE
  CANCELLED
}

enum HrTaskPriority {
  LOW
  NORMAL
  HIGH
}

model HrTask {
  id         Int            @id @default(autoincrement())
  title      String
  desc       String?
  assigneeId Int
  dueAt      DateTime?
  priority   HrTaskPriority @default(NORMAL)
  status     HrTaskStatus   @default(OPEN)
  createdById Int
  createdByName String
  doneAt     DateTime?
  createdAt  DateTime       @default(now())
  @@index([assigneeId, status])
}

model KpiTarget {
  id            Int    @id @default(autoincrement())
  userId        Int
  period        String
  targetRevenue Int    @default(0)
  note          String?
  @@unique([userId, period])
}

enum CommissionBasis {
  REVENUE
  COLLECTED
}

model CommissionRule {
  id        Int             @id @default(autoincrement())
  version   Int             @unique
  basis     CommissionBasis @default(REVENUE)
  pct       Decimal         @db.Decimal(5, 2)
  note      String?
  createdById Int
  createdByName String
  createdAt DateTime        @default(now())
}

enum CommissionPeriodStatus {
  LOCKED
}

model CommissionPeriod {
  id          Int    @id @default(autoincrement())
  period      String @unique
  ruleVersion Int
  basis       CommissionBasis
  pct         Decimal @db.Decimal(5, 2)
  status      CommissionPeriodStatus @default(LOCKED)
  lines       CommissionLine[]
  lockedById  Int
  lockedByName String
  lockedAt    DateTime @default(now())
}

model CommissionLine {
  id       Int              @id @default(autoincrement())
  periodId Int
  periodRef CommissionPeriod @relation(fields: [periodId], references: [id])
  userId   Int
  base     Int
  amount   Int
  @@unique([periodId, userId])
}

enum PayrollStatus {
  DRAFT
  APPROVED
  PAID
}

model PayrollSlip {
  id           Int           @id @default(autoincrement())
  code         String        @unique
  userId       Int
  period       String
  baseSalary   Int           @default(0)
  workDays     Decimal       @db.Decimal(5, 2) @default(0)
  standardDays Int           @default(26)
  salaryByDays Int           @default(0)
  allowance    Int           @default(0)
  commission   Int           @default(0)
  bonus        Int           @default(0)
  penalty      Int           @default(0)
  advance      Int           @default(0)
  total        Int           @default(0)
  status       PayrollStatus @default(DRAFT)
  cashTxId     Int?
  approvedById Int?
  approvedByName String?
  approvedAt   DateTime?
  paidAt       DateTime?
  note         String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  @@unique([userId, period])
}

// ===== GD9: PORTAL DAI LY / KHACH HANG =====

model PortalAccount {
  id           Int      @id @default(autoincrement())
  partnerId    Int      @unique
  username     String   @unique
  passwordHash String
  active       Boolean  @default(true)
  sessions     PortalSession[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model PortalSession {
  token     String        @id
  accountId Int
  account   PortalAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime      @default(now())
  @@index([expiresAt])
}

// ===== GD11: GIAN HANG ONLINE — GIO HANG & KHUYEN MAI =====

// Theo doi "khach da them vao gio nhung CHUA mua" — chi ghi khi khach da dang nhap cong.
// converted=true khi khach dat don (checkout). Quan tri xem duoc gio bo quen de goi cham soc.
model ShopCartActivity {
  id            Int      @id @default(autoincrement())
  partnerId     Int?
  partnerName   String
  phone         String?
  variantId     Int
  productCode   String
  productName   String
  optLabel      String?
  qty           Int      @default(1)
  unitPrice     Int      @default(0)
  converted     Boolean  @default(false)
  convertedCode String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  @@index([converted, updatedAt])
  @@index([partnerId])
}

enum PromoType {
  PERCENT
  AMOUNT
}

// Khuyen mai / ma giam gia (kieu Shopee): quan tri tao — khach nhap ma o thanh toan de giam tien.
model Promotion {
  id          Int       @id @default(autoincrement())
  code        String    @unique
  name        String
  type        PromoType @default(AMOUNT)
  value       Int       @default(0)   // PERCENT: % giam; AMOUNT: so tien giam
  minOrder    Int       @default(0)   // don toi thieu de ap dung
  maxDiscount Int?                     // tran giam (cho PERCENT)
  active      Boolean   @default(true)
  validFrom   DateTime?
  validTo     DateTime?
  imageUrl    String?
  videoUrl    String?
  note        String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  @@index([active])
}

// ===== GD10: TICH HOP & WEBHOOK =====

enum IntegrationStatus {
  SANDBOX
  SENT
  ERROR
}

// Nhat ky moi lan he thong GUI ra kenh ngoai (sandbox = CHUA gui that, chi ghi nhan)
model IntegrationLog {
  id        Int               @id @default(autoincrement())
  channel   String
  direction String            @default("OUT")
  summary   String
  payload   Json?
  status    IntegrationStatus @default(SANDBOX)
  error     String?
  createdAt DateTime          @default(now())
  @@index([channel, createdAt])
}

// Su kien webhook NHAN vao — idempotent theo eventId, co retry/error de xu ly lai
model WebhookEvent {
  id        Int      @id @default(autoincrement())
  channel   String
  eventId   String
  payload   Json
  status    String   @default("OK")
  error     String?
  retries   Int      @default(0)
  createdAt DateTime @default(now())
  @@unique([channel, eventId])
  @@index([status])
}
