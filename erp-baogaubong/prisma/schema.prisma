generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id        Int      @id @default(autoincrement())
  name      String
  taxCode   String?
  address   String?
  phone     String?
  web       String?
  logoUrl   String?
  branches  Branch[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Branch {
  id         Int         @id @default(autoincrement())
  companyId  Int
  company    Company     @relation(fields: [companyId], references: [id])
  code       String      @unique
  name       String
  address    String?
  warehouses Warehouse[]
  users      User[]
  deletedAt  DateTime?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
}

model Warehouse {
  id        Int       @id @default(autoincrement())
  branchId  Int
  branch    Branch    @relation(fields: [branchId], references: [id])
  code      String    @unique
  name      String
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Role {
  id       Int              @id @default(autoincrement())
  code     String           @unique
  name     String
  isSystem Boolean          @default(false)
  perms    RolePermission[]
  users    User[]
}

model Permission {
  id    Int              @id @default(autoincrement())
  code  String           @unique
  name  String
  roles RolePermission[]
}

model RolePermission {
  roleId       Int
  permissionId Int
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  @@id([roleId, permissionId])
}

enum DataScope {
  OWN
  TEAM
  BRANCH
  ALL
}

model User {
  id           Int       @id @default(autoincrement())
  username     String    @unique
  passwordHash String
  name         String
  email        String?
  phone        String?
  roleId       Int
  role         Role      @relation(fields: [roleId], references: [id])
  branchId     Int?
  branch       Branch?   @relation(fields: [branchId], references: [id])
  scope        DataScope @default(OWN)
  active       Boolean   @default(true)
  deletedAt    DateTime?
  sessions     Session[]
  partnersSale    Partner[]      @relation("PartnerSale")
  partnersCreated Partner[]      @relation("PartnerCreator")
  careAssigned    CareActivity[] @relation("CareAssignee")
  careCreated     CareActivity[] @relation("CareCreator")
  filesUploaded   Attachment[]   @relation("FileUploader")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  @@index([roleId])
}

model Session {
  token     String   @id
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  ip        String?
  ua        String?
  createdAt DateTime @default(now())
  @@index([userId])
  @@index([expiresAt])
}

model Setting {
  key   String @id
  value Json
}

model DocumentSequence {
  id         Int    @id @default(autoincrement())
  prefix     String
  branchCode String
  period     String
  nextNo     Int    @default(1)
  @@unique([prefix, branchCode, period])
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  actorId   Int?
  actorName String
  action    String
  entity    String
  entityId  String?
  before    Json?
  after     Json?
  ip        String?
  ua        String?
  at        DateTime @default(now())
  @@index([entity, entityId])
  @@index([at])
}

// ===== GD2: SAN PHAM & HANG HOA =====

enum ProductType {
  FINISHED
  MATERIAL
  SEMI
  SERVICE
  COMBO
  CUSTOM
  AI_BEAR
}

enum ProductStatus {
  ACTIVE
  INACTIVE
}

model Category {
  id       Int       @id @default(autoincrement())
  name     String
  parentId Int?
  parent   Category?  @relation("CatTree", fields: [parentId], references: [id])
  children Category[] @relation("CatTree")
  products Product[]
  deletedAt DateTime?
}

model Unit {
  id       Int    @id @default(autoincrement())
  code     String @unique
  name     String
  products Product[]
  fromConv UnitConversion[] @relation("FromUnit")
  toConv   UnitConversion[] @relation("ToUnit")
}

model UnitConversion {
  id         Int   @id @default(autoincrement())
  fromUnitId Int
  toUnitId   Int
  factor     Decimal @db.Decimal(18, 6)
  fromUnit   Unit  @relation("FromUnit", fields: [fromUnitId], references: [id])
  toUnit     Unit  @relation("ToUnit", fields: [toUnitId], references: [id])
  locked     Boolean @default(false)
  @@unique([fromUnitId, toUnitId])
}

model Product {
  id         Int           @id @default(autoincrement())
  code       String        @unique
  name       String
  type       ProductType
  status     ProductStatus @default(ACTIVE)
  categoryId Int?
  category   Category?     @relation(fields: [categoryId], references: [id])
  unitId     Int
  unit       Unit          @relation(fields: [unitId], references: [id])
  brand      String?
  tags       String[]      @default([])
  desc       String?
  imageUrls  String[]      @default([])
  taxPercent Int?
  costRef    Int           @default(0)
  deductMode String?
  note       String?
  variants   ProductVariant[]
  bundleItems BundleItem[] @relation("ComboOwner")
  boms       Bom[]
  version    Int           @default(1)
  deletedAt  DateTime?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  @@index([type, status])
  @@index([name])
}

model ProductVariant {
  id        Int      @id @default(autoincrement())
  productId Int
  product   Product  @relation(fields: [productId], references: [id])
  sku       String   @unique
  barcode   String?  @unique
  size      String?
  color     String?
  material  String?
  costPrice Int      @default(0)
  weightGr  Int?
  imageUrls String[] @default([])
  status    ProductStatus @default(ACTIVE)
  priceRules PriceRule[]
  bundleComponents BundleItem[] @relation("ComponentVariant")
  bomItems  BomItem[]
  aiDevices AiDevice[]
  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([productId])
}

enum PriceListKind {
  RETAIL
  WHOLESALE
  AGENT
  COMPANY
  CUSTOM
}

model PriceList {
  id        Int           @id @default(autoincrement())
  kind      PriceListKind
  name      String
  priority  Int           @default(0)
  validFrom DateTime?
  validTo   DateTime?
  active    Boolean       @default(true)
  rules     PriceRule[]
  deletedAt DateTime?
}

model PriceRule {
  id          Int            @id @default(autoincrement())
  priceListId Int
  priceList   PriceList      @relation(fields: [priceListId], references: [id])
  variantId   Int
  variant     ProductVariant @relation(fields: [variantId], references: [id])
  minQty      Int            @default(1)
  price       Int
  @@unique([priceListId, variantId, minQty])
  @@index([variantId])
}

model BundleItem {
  id                 Int            @id @default(autoincrement())
  comboProductId     Int
  comboProduct       Product        @relation("ComboOwner", fields: [comboProductId], references: [id])
  componentVariantId Int
  componentVariant   ProductVariant @relation("ComponentVariant", fields: [componentVariantId], references: [id])
  qty                Int
  @@unique([comboProductId, componentVariantId])
}

model Bom {
  id        Int          @id @default(autoincrement())
  productId Int
  product   Product      @relation(fields: [productId], references: [id])
  name      String
  versions  BomVersion[]
  deletedAt DateTime?
}

enum BomStatus {
  DRAFT
  ACTIVE
  RETIRED
}

model BomVersion {
  id        Int       @id @default(autoincrement())
  bomId     Int
  bom       Bom       @relation(fields: [bomId], references: [id])
  no        Int
  status    BomStatus @default(DRAFT)
  validFrom DateTime?
  wastePct  Decimal   @db.Decimal(5, 2) @default(0)
  items     BomItem[]
  createdAt DateTime  @default(now())
  @@unique([bomId, no])
}

model BomItem {
  id                Int            @id @default(autoincrement())
  bomVersionId      Int
  bomVersion        BomVersion     @relation(fields: [bomVersionId], references: [id])
  materialVariantId Int
  materialVariant   ProductVariant @relation(fields: [materialVariantId], references: [id])
  qtyPerUnit        Decimal        @db.Decimal(18, 4)
  note              String?
}

model AiDevice {
  id             Int            @id @default(autoincrement())
  variantId      Int
  variant        ProductVariant @relation(fields: [variantId], references: [id])
  serial         String         @unique
  activatedAt    DateTime?
  warrantyMonths Int            @default(12)
  note           String?
  createdAt      DateTime       @default(now())
}

// ===== GD3: DOI TAC & CRM =====

enum PartnerType {
  PERSON
  COMPANY
}

model PartnerGroup {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  partners Partner[]
}

model Partner {
  id           Int         @id @default(autoincrement())
  code         String      @unique
  name         String
  type         PartnerType @default(PERSON)
  isCustomer   Boolean     @default(true)
  isSupplier   Boolean     @default(false)
  isAgent      Boolean     @default(false)
  phone        String?
  normPhone    String?
  email        String?
  normEmail    String?
  taxCode      String?
  groupId      Int?
  group        PartnerGroup? @relation(fields: [groupId], references: [id])
  source       String?
  channel      String?
  priceListId  Int?
  assignedToId Int?
  assignedTo   User?       @relation("PartnerSale", fields: [assignedToId], references: [id])
  createdById  Int?
  createdBy    User?       @relation("PartnerCreator", fields: [createdById], references: [id])
  branchId     Int?
  creditLimit  Int         @default(0)
  creditDays   Int         @default(0)
  note         String?
  mergedIntoId Int?
  contacts     PartnerContact[]
  addresses    PartnerAddress[]
  activities   CareActivity[]
  attachments  Attachment[]
  deletedAt    DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  @@index([normPhone])
  @@index([normEmail])
  @@index([taxCode])
  @@index([assignedToId])
  @@index([name])
}

model PartnerContact {
  id        Int     @id @default(autoincrement())
  partnerId Int
  partner   Partner @relation(fields: [partnerId], references: [id])
  name      String
  phone     String?
  email     String?
  position  String?
  note      String?
  deletedAt DateTime?
}

model PartnerAddress {
  id         Int     @id @default(autoincrement())
  partnerId  Int
  partner    Partner @relation(fields: [partnerId], references: [id])
  label      String?
  address    String
  isBilling  Boolean @default(false)
  isShipping Boolean @default(false)
  deletedAt  DateTime?
}

enum CareKind {
  NOTE
  CALL
  TASK
  MEETING
}

model CareActivity {
  id          Int      @id @default(autoincrement())
  partnerId   Int
  partner     Partner  @relation(fields: [partnerId], references: [id])
  kind        CareKind @default(NOTE)
  content     String
  dueAt       DateTime?
  remindAt    DateTime?
  doneAt      DateTime?
  assigneeId  Int?
  assignee    User?    @relation("CareAssignee", fields: [assigneeId], references: [id])
  createdById Int
  createdBy   User     @relation("CareCreator", fields: [createdById], references: [id])
  deletedAt   DateTime?
  createdAt   DateTime @default(now())
  @@index([partnerId])
  @@index([assigneeId, doneAt])
}

model Attachment {
  id           Int      @id @default(autoincrement())
  partnerId    Int?
  partner      Partner? @relation(fields: [partnerId], references: [id])
  entity       String
  entityId     String
  fileName     String
  mime         String
  size         Int
  storageKey   String   @unique
  uploadedById Int
  uploadedBy   User     @relation("FileUploader", fields: [uploadedById], references: [id])
  deletedAt    DateTime?
  createdAt    DateTime @default(now())
  @@index([entity, entityId])
}

// ===== GD4: BAO GIA, DON HANG, POS =====

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  CANCELLED
}

enum ApprovalStatus {
  NONE
  PENDING
  APPROVED
  REJECTED
}

enum OrderStatus {
  NEW
  CONFIRMED
  DONE
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
  REFUNDED
}

enum ProductionStatus {
  NONE
  QUEUED
  IN_PROGRESS
  FINISHED
}

enum ShippingStatus {
  NONE
  PREPARING
  SHIPPING
  DELIVERED
  RETURNED
}

enum PayMethod {
  CASH
  TRANSFER
}

model Quote {
  id             Int            @id @default(autoincrement())
  code           String         @unique
  version        Int            @default(1)
  partnerId      Int?
  partnerName    String
  priceListId    Int?
  status         QuoteStatus    @default(DRAFT)
  approvalStatus ApprovalStatus @default(NONE)
  approvalReason String?
  approvedById   Int?
  approvedAt     DateTime?
  vatEnabled     Boolean        @default(true)
  vatPercent     Int            @default(8)
  subtotal       Int            @default(0)
  discountPct    Decimal        @db.Decimal(5, 2) @default(0)
  discountAmt    Int            @default(0)
  otherFee       Int            @default(0)
  shippingFee    Int            @default(0)
  taxAmt         Int            @default(0)
  total          Int            @default(0)
  validUntil     DateTime?
  note           String?
  lines          QuoteLine[]
  revisions      QuoteRevision[]
  order          SalesOrder?
  assignedToId   Int?
  createdById    Int
  branchId       Int?
  deletedAt      DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  @@index([partnerId])
  @@index([status])
}

model QuoteLine {
  id          Int     @id @default(autoincrement())
  quoteId     Int
  quote       Quote   @relation(fields: [quoteId], references: [id])
  variantId   Int?
  sku         String
  name        String
  unit        String
  qty         Int
  unitPrice   Int
  discountPct Decimal @db.Decimal(5, 2) @default(0)
  taxPercent  Int     @default(0)
  lineTotal   Int
  note        String?
}

model QuoteRevision {
  id        Int      @id @default(autoincrement())
  quoteId   Int
  quote     Quote    @relation(fields: [quoteId], references: [id])
  version   Int
  data      Json
  createdAt DateTime @default(now())
  @@unique([quoteId, version])
}

model SalesOrder {
  id               Int              @id @default(autoincrement())
  code             String           @unique
  quoteId          Int?             @unique
  quote            Quote?           @relation(fields: [quoteId], references: [id])
  partnerId        Int?
  partnerName      String
  orderStatus      OrderStatus      @default(NEW)
  paymentStatus    PaymentStatus    @default(UNPAID)
  productionStatus ProductionStatus @default(NONE)
  shippingStatus   ShippingStatus   @default(NONE)
  approvalStatus   ApprovalStatus   @default(NONE)
  approvalReason   String?
  approvedById     Int?
  approvedAt       DateTime?
  vatEnabled       Boolean          @default(true)
  vatPercent       Int              @default(8)
  subtotal         Int              @default(0)
  discountPct      Decimal          @db.Decimal(5, 2) @default(0)
  discountAmt      Int              @default(0)
  otherFee         Int              @default(0)
  shippingFee      Int              @default(0)
  taxAmt           Int              @default(0)
  total            Int              @default(0)
  paidAmt          Int              @default(0)
  isPos            Boolean          @default(false)
  note             String?
  lines            OrderLine[]
  payments         Payment[]
  assignedToId     Int?
  createdById      Int
  branchId         Int?
  deletedAt        DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  @@index([partnerId])
  @@index([orderStatus, paymentStatus])
  @@index([createdAt])
}

model OrderLine {
  id          Int        @id @default(autoincrement())
  orderId     Int
  order       SalesOrder @relation(fields: [orderId], references: [id])
  variantId   Int?
  sku         String
  name        String
  unit        String
  qty         Int
  unitPrice   Int
  discountPct Decimal    @db.Decimal(5, 2) @default(0)
  taxPercent  Int        @default(0)
  lineTotal   Int
  note        String?
}

model Payment {
  id          Int        @id @default(autoincrement())
  code        String     @unique
  orderId     Int
  order       SalesOrder @relation(fields: [orderId], references: [id])
  partnerId   Int?
  amount      Int
  method      PayMethod  @default(CASH)
  note        String?
  cashTxId    Int?
  createdById Int
  createdAt   DateTime   @default(now())
  @@index([orderId])
  @@index([createdAt])
}

model StatusHistory {
  id        Int      @id @default(autoincrement())
  entity    String
  entityId  Int
  axis      String
  fromVal   String
  toVal     String
  note      String?
  byId      Int
  byName    String
  createdAt DateTime @default(now())
  @@index([entity, entityId])
}

// ===== GD5: THU TIEN, CONG NO, SO QUY =====

enum CashAccountKind {
  CASH
  BANK
  COD
}

enum CashTxKind {
  RECEIPT
  PAYMENT
  TRANSFER_IN
  TRANSFER_OUT
  REFUND
}

enum CashTxStatus {
  PENDING
  APPROVED
  REJECTED
}

model CashAccount {
  id             Int             @id @default(autoincrement())
  code           String          @unique
  name           String
  kind           CashAccountKind
  openingBalance Int             @default(0)
  active         Boolean         @default(true)
  txs            CashTransaction[]
  createdAt      DateTime        @default(now())
}

model CashTransaction {
  id             Int          @id @default(autoincrement())
  code           String       @unique
  kind           CashTxKind
  status         CashTxStatus @default(APPROVED)
  accountId      Int
  account        CashAccount  @relation(fields: [accountId], references: [id])
  amount         Int
  partnerId      Int?
  partnerName    String?
  orderId        Int?
  reason         String?
  note           String?
  happenedAt     DateTime     @default(now())
  period         String
  transferGroup  String?
  refundOfId     Int?
  refundOf       CashTransaction?  @relation("RefundLink", fields: [refundOfId], references: [id])
  refunds        CashTransaction[] @relation("RefundLink")
  idempotencyKey String?      @unique
  approvedById   Int?
  approvedAt     DateTime?
  createdById    Int
  createdByName  String
  createdAt      DateTime     @default(now())
  @@index([accountId, period])
  @@index([orderId])
  @@index([partnerId])
  @@index([happenedAt])
}

model PeriodLock {
  period       String    @id
  locked       Boolean   @default(true)
  lockedById   Int
  lockedByName String
  lockedAt     DateTime  @default(now())
  note         String?
}
